{
  "network": {
    "allowedDomains": [],
    "deniedDomains": []
  },
  "filesystem": {
    "denyRead": [
      "~/.ssh",
      "~/.aws",
      "~/.gnupg",
      "~/.config/gog",
      "~/.pi/agent/auth.json"
    ],
    "allowWrite": [
      "."
    ],
    "denyWrite": [
      "**/.git",
      "**/.github",
      "**/.husky",
      "**/.vscode",
      "**/.pi",
      "**/.envrc",
      "**/.pre-commit-config.yaml",
      "**/.gitmodules",
      "**/.codex",
      "**/.cursor",
      "**/.agents",
      "**/.claude",
      "**/.opencode",
      "**/.env",
      "**/.env.*",
      "**/*.pem",
      "**/*.key"
    ]
  }
}
